# 金生链后端环境配置模板
# 复制本文件为 .env 并填写实际值

# MySQL 数据库连接
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/nongyao

# JWT 密钥（生产环境请使用随机长字符串）
SECRET_KEY=your-secret-key-here

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 调试模式
DEBUG=False

# 区块链功能开关（默认开启；未安装 Ganache 或部署环境无需上链时改为 False）
# False 时系统自动降级为本地存证模式，不影响其他功能
BLOCKCHAIN_ENABLED=True

# Ganache 区块链节点（npm install 后由 main.py 自动拉起，一般无需手动安装）
GANACHE_URL=http://localhost:7545
GANACHE_PRIVATE_KEY=your-ganache-private-key

# IPFS 功能开关（默认开启；未安装 IPFS Kubo 时请改为 False，否则带文件上链接口会报错）
IPFS_ENABLED=True

# IPFS 节点（可选；需自行安装 IPFS Kubo 并启动 daemon）
IPFS_GATEWAY=http://localhost:8080
IPFS_API_URL=http://localhost:5001/api/v0

# 前端地址（用于生成溯源二维码）
FRONTEND_URL=http://localhost:5173
