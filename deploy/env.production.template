# 金生链 · 生产环境配置模板
# deploy.sh 会自动复制为 backend/.env，并填入数据库密码、SECRET_KEY、公网 IP
# 手动改完记得重启后端：sudo systemctl restart nongyao

# 数据库（deploy.sh 会按实际创建的用户密码覆盖这一行）
DATABASE_URL=mysql+pymysql://nongyao:nongyao2026@localhost:3306/nongyao

# JWT 密钥（deploy.sh 会生成 64 位随机串覆盖）
SECRET_KEY=CHANGE_ME_BY_DEPLOY_SCRIPT
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 生产环境必须关闭调试：关闭后 CORS 只放行 FRONTEND_URL，更安全
DEBUG=False

# 服务器不装 Ganache / IPFS，关掉可跳过启动尝试、加快启动
# 区块链存证自动降级为本地存证，溯源/传感器/业务模块完全不受影响
BLOCKCHAIN_ENABLED=False
IPFS_ENABLED=False

GANACHE_URL=http://localhost:7545
GANACHE_PRIVATE_KEY=
IPFS_GATEWAY=http://localhost:8080
IPFS_API_URL=http://localhost:5001/api/v0

# 前端地址：CORS 白名单 + 溯源二维码生成用
# deploy.sh 会自动替换成 http://你的公网IP，千万别留 localhost
FRONTEND_URL=http://localhost
